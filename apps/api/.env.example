# Development environment only; explicitly inject as environment variables.
API_PORT=4100
CORS_ORIGINS=http://localhost:5173
ENABLE_SWAGGER=0
DATABASE_URL=postgresql://gst_app:REPLACE_ME@127.0.0.1:5432/gst_saas_dev
AUTH_DATABASE_URL=postgresql://gst_auth:REPLACE_ME@127.0.0.1:5432/gst_saas_dev
# No public registration endpoints until explicitly enabled and audited:
ENABLE_REGISTRATION=0
REGISTRATION_DATABASE_URL=postgresql://gst_registration:REPLACE_ME@127.0.0.1:5432/gst_saas_dev
REGISTRATION_HMAC_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=no-reply@example.invalid
REGISTRATION_VERIFY_URL=https://staging.example.invalid/verify-email
